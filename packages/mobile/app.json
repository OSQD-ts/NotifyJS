{
  "expo": {
    "name": "NotifyJS",
    "slug": "notifyjs",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "notifyjs",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e1116"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.notifyjs.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "NotifyJS uses the camera only to scan a pairing QR code."
      }
    },
    "android": {
      "package": "dev.notifyjs.app",
      "permissions": [
        "VIBRATE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "INTERNET",
        "CAMERA",
        "USE_FULL_SCREEN_INTENT",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "usesCleartextTraffic": true,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1b3fb8"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1b3fb8"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NotifyJS uses the camera only to scan a pairing QR code.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withLockScreenCalls"
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
