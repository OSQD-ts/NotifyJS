{
  "name": "@osqd/notifyjs-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "NotifyJS desktop client: the phone app's feed, settings and spoken calls, on a computer.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./dist/main.js",
  "desktopName": "notifyjs-desktop.desktop",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dev": "node build.mjs --watch",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux --x64 --arm64",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "install:local": "node scripts/install-local.mjs",
    "uninstall:local": "node scripts/install-local.mjs --uninstall"
  },
  "dependencies": {
    "@osqd/notifyjs-protocol": "file:../protocol",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.24.2"
  },
  "build": {
    "appId": "dev.notifyjs.desktop",
    "productName": "NotifyJS",
    "executableName": "notifyjs-desktop",
    "publish": null,
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "notifyjs-desktop-linux-${arch}.${ext}",
      "category": "Utility",
      "icon": "assets/icon.png",
      "synopsis": "Self-hosted alerts and spoken calls from your own hubs",
      "description": "NotifyJS desktop client. Subscribes to your own NotifyJS hubs over an encrypted WebSocket, shows a merged alert feed, and rings like a phone call for anything urgent enough to be spoken aloud.",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "notifyjs-desktop-macos-${arch}.${ext}",
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "notifyjs-desktop-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NotifyJS",
      "uninstallDisplayName": "NotifyJS"
    },
    "deb": {
      "packageName": "notifyjs-desktop",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "author": "OSQD <OSQD-ts@users.noreply.github.com>",
  "homepage": "https://github.com/OSQD-ts/NotifyJS"
}
