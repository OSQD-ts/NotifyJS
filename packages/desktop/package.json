{
  "name": "@osqd/notifyjs-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "NotifyJS desktop client: the phone app's feed, settings and spoken calls, on a computer.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dev": "node build.mjs --watch",
    "dist": "npm run build && electron-builder",
    "install:local": "node scripts/install-local.mjs",
    "uninstall:local": "node scripts/install-local.mjs --uninstall"
  },
  "dependencies": {
    "@osqd/notifyjs-protocol": "file:../protocol",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.24.2"
  },
  "build": {
    "appId": "dev.notifyjs.desktop",
    "productName": "NotifyJS",
    "executableName": "notifyjs-desktop",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "synopsis": "Self-hosted alerts and spoken calls from your own hubs",
      "description": "NotifyJS desktop client. Subscribes to your own NotifyJS hubs over an encrypted WebSocket, shows a merged alert feed, and rings like a phone call for anything urgent enough to be spoken aloud.",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "deb": {
      "packageName": "notifyjs-desktop",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "author": "OSQD <OSQD-ts@users.noreply.github.com>",
  "homepage": "https://github.com/OSQD-ts/NotifyJS"
}
