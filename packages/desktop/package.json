{
  "name": "@osqd/notifyjs-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "NotifyJS desktop client: the phone app's feed, settings and spoken calls, on a computer.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dev": "node build.mjs --watch",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@osqd/notifyjs-protocol": "file:../protocol",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.24.2"
  },
  "build": {
    "appId": "dev.notifyjs.desktop",
    "productName": "NotifyJS",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
