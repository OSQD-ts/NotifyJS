{
  "name": "@osqd/notifyjs",
  "version": "0.1.0",
  "description": "Embed a hardened notification hub in your app: one import, one call, every device you own.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "@osqd/notifyjs-protocol": "0.1.0",
    "@osqd/notifyjs-web": "0.1.0",
    "qrcode-generator": "^1.5.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OSQD-ts/NotifyJS.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/OSQD-ts/NotifyJS#readme",
  "bugs": {
    "url": "https://github.com/OSQD-ts/NotifyJS/issues"
  }
