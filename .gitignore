node_modules/
dist/
*.tsbuildinfo
.notifyjs/
.env
.DS_Store
packages/mobile/.expo/
.notifyjs-demo/
build/

# Generated by `expo prebuild`, which CI runs with --clean on every release.
# Committing it means the generated tree and the committed one drift apart,
# and it drags a debug keystore along with it.
packages/mobile/android/
packages/mobile/ios/

# Copied from the repo root by each package's `prepack`. One source of truth.
packages/*/LICENSE

# Rendered from assets/*.svg by `npm run icons`.
packages/mobile/assets/
packages/web/public/favicon.png
packages/web/public/icon.svg
packages/desktop/assets/

# electron-builder's output: installers are release artifacts, not sources.
packages/desktop/release/

# Local agent instructions
CLAUDE.md
.claude/

# Emitted only so `node --test` can load the mobile package's pure logic.
packages/mobile/dist-test/

# tsc pointed at this package without an explicit `include` emits JavaScript
# next to every source file it can reach. That output is not the app - Metro
# bundles the TypeScript - and committing it once was enough.
packages/mobile/App.js
packages/mobile/src/*.js
packages/mobile/modules/notifyjs-call/index.js
